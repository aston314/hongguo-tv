+/* Experimental BVC2 identification. ByteVC2 streams may use hvc1 with a
+ * bv2C atom. Do not feed its proprietary configuration record to HEVC or VVC
+ * vvcc parsing. The BVC2 decoder reads length-prefixed in-band parameter sets,
+ * matching the independently validated explicit-decoder experiment. */
+static int mov_read_bv2c(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    AVStream *st = get_curr_st(c);
+    if (!st || atom.size < 1)
+        return AVERROR_INVALIDDATA;
+    st->codecpar->codec_id = AV_CODEC_ID_BVC2;
+    avio_skip(pb, atom.size);
+    return 0;
+}
